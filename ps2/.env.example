# ── TCS GenAI Lab Proxy ──────────────────────────────────────────────────────
OPENAI_API_KEY=your-hackathon-api-key-here
AZURE_GENAI_API_KEY=your-hackathon-api-key-here
OPENAI_BASE_URL=https://genailab.tcs.in

# ── Model selector ───────────────────────────────────────────────────────────
LLM_MODEL=azure/genailab-maas-gpt-4o-mini

# ── SSL ───────────────────────────────────────────────────────────────────────
PYTHONHTTPSVERIFY=0
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=

# ── Provider selector ─────────────────────────────────────────────────────────
# tcs  → TCS GenAI proxy at https://genailab.tcs.in (default)
# ollama → local Ollama service (must be running as systemd service)
LLM_PROVIDER=tcs

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Do NOT add /v1 — it is appended automatically
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY is optional; Ollama does not require authentication
